# Unified Backend Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/ava-solutions
DB_POOL_SIZE=10
LOG_SLOW_QUERIES=false

# Redis (optional - for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_SECRET=your-refresh-token-secret
SESSION_SECRET=your-session-secret-key-change-in-production

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ============================================
# CORS & ALLOWED ORIGINS
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# ============================================
# API KEYS & EXTERNAL SERVICES
# ============================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid/Email
SENDGRID_API_KEY=
EMAIL_FROM=noreply@avasolutions.com
EMAIL_FROM_NAME=Ava Solutions

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_DIR=./logs
DETAILED_LOGGING=false
LOG_QUERIES=false
LOG_ERRORS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# MONITORING & ANALYTICS
# ============================================
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
GOOGLE_ANALYTICS_ID=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WEBSOCKETS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=local
BACKUP_PATH=./backups

# ============================================
# WORKER CONFIGURATION
# ============================================
ENABLE_WORKERS=true
WORKER_CONCURRENCY=2
JOB_TIMEOUT=30000

# ============================================
# API DOCUMENTATION
# ============================================
API_DOCS_ENABLED=true
API_DOCS_URL=/api/docs
SWAGGER_UI_ENABLED=true

# ============================================
# DEVELOPMENT TOOLS
# ============================================
ENABLE_PLAYGROUND=false
ENABLE_DEBUG_ROUTES=false
SEED_DATABASE=false

# ============================================
# DEPLOYMENT
# ============================================
DEPLOYMENT_ENV=local
DEPLOYMENT_REGION=us-east-1
CDN_URL=

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================
# INTERNAL API KEYS
# ============================================
# Comma-separated list of valid API keys for service-to-service communication
VALID_API_KEYS=

# ============================================
# PERFORMANCE
# ============================================
ENABLE_CACHE=true
CACHE_TTL=3600
ENABLE_COMPRESSION=true
ENABLE_ETAG=true