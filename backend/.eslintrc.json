{
    "env": {
        "es2021": true,
        "node": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "indent": ["off"],
        "linebreak-style": ["off"],
        "quotes": ["warn", "single"],
        "semi": ["error", "always"],
        "no-unused-vars": "warn",
        "no-console": "off",
        "no-undef": "error"
    },
    "ignorePatterns": [
        "node_modules/",
        "coverage/",
        "*.config.js",
        "scripts/",
        "test/"
    ]
}