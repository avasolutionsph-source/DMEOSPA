# Backend Environment Configuration
# IMPORTANT: Replace these values with your actual credentials

# MongoDB Database Connection
# TODO: Replace with your actual MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ava-solutions-local

# JWT Secret Key for Authentication
JWT_SECRET=dev-secret-key-change-in-production-12345

# Server Configuration
PORT=4001
NODE_ENV=development
HOST=0.0.0.0

# Allowed Origins for CORS
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:8080,http://localhost:8082,http://localhost:4001,http://127.0.0.1:8082

# Session Secret
SESSION_SECRET=dev-session-secret-change-in-production

# JWT Configuration
JWT_EXPIRES_IN=7d
