# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ava-solutions
MONGODB_URI_PROD=your-production-mongodb-uri

# JWT Secret (REQUIRED for production)
JWT_SECRET=your-super-secure-jwt-secret-key-here-at-least-32-characters

# Admin Account (Secured)
ADMIN_EMAIL=avasolutionsph@gmail.com
ADMIN_PASSWORD=your-secure-admin-password-here

# Server Configuration
PORT=4000
NODE_ENV=development

# Email Configuration (if using email features)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

# Redis Configuration (if using caching)
REDIS_URL=redis://localhost:6379