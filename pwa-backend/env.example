# Ava Solutions PWA Backend Configuration
                            NODE_ENV=development
PORT=4000

# MongoDB Connection (Replace with your actual MongoDB URI)
MONGO_URI=mongodb://localhost:27017/ava-solutions-pwa

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500